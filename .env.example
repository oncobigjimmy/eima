# Eima Salut no necesita variables SMTP: el contacto se realiza por WhatsApp,
# teléfono y email. Los datos públicos se configuran en src/lib/site.js.

# Configuración del servidor Node en producción (definir en Hostinger,
# no copiar ORIGIN de producción al servidor local de desarrollo):
# NODE_ENV=production
# ORIGIN=https://eimasalut.es
# PORT lo asigna el hosting; no fijarlo sin comprobar su configuración.
# HOST=0.0.0.0 si el hosting necesita escuchar en todas las interfaces.
# npm start no carga automáticamente archivos .env.
